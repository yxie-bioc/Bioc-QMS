# Runtime process only. Never put migration/admin credentials in this file.
APP_ENV=production
APP_ORIGIN=https://quality.internal.example
COOKIE_SECURE=true
DATABASE_URL=postgresql://bbc_web:REPLACE@database:5432/bbc_prod
ATTACHMENT_DIR=/app/var/attachments
NOTIFICATION_ADAPTER=in-app
NEXT_TELEMETRY_DISABLED=1
# The worker gets its own DATABASE_URL using bbc_worker.
# A separate operations shell gets MIGRATION_DATABASE_URL using bbc_owner.
# Production secrets can be generated privately with scripts/configure-production.mjs.
